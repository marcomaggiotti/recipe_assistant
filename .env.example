SERVICE_NAME=pizza-service
API_KEY=

# sqlite | postgres | cosmos
DB_BACKEND=sqlite
SQLITE_PATH=./pizza_service.db

# Postgres - works for local docker-compose Postgres or Render managed Postgres.
# Render connection string: postgresql://<user>:<password>@<host>/<database>
POSTGRES_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pizza_db

# Azure Cosmos DB (NoSQL API)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=ai-agent
COSMOS_CONTAINER=pizza_recipes

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

CORS_ALLOW_ORIGINS=*

# Standalone flour-catalogue microservice (github.com/marcomaggiotti/flour_service) -
# the single source of truth for the flour catalogue (see app/flours.py). The
# /flour-explorer page's JS calls this directly from the browser, and this service's
# own backend (app/flours.py's HttpFlourCatalogStore) calls it too, for
# /recipes/generate's flour validation - there's no local catalogue copy in this repo.
# Override FLOUR_SERVICE_URL for local dev if you're running flour-service locally too
# (e.g. http://localhost:8001). FLOUR_SERVICE_API_KEY is only needed if that deployment
# has its own API_KEY set.
FLOUR_SERVICE_URL=https://flour-service.onrender.com
FLOUR_SERVICE_API_KEY=

# --- topping-service ---
# Separate microservice (topping_service/), built from the same image as pizza-service
# (see Dockerfile/docker-entrypoint.sh) but run as its own container - see
# docker-compose.yml. Its settings are prefixed TOPPING_ so they don't collide with the
# pizza-service settings above, even though both read this same .env file.
TOPPING_SERVICE_NAME=topping-service
TOPPING_API_KEY=

# sqlite | postgres | cosmos
TOPPING_DB_BACKEND=sqlite
TOPPING_SQLITE_PATH=./topping_service.db
TOPPING_POSTGRES_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/topping_db

TOPPING_COSMOS_ENDPOINT=
TOPPING_COSMOS_KEY=
TOPPING_COSMOS_DATABASE=ai-agent
TOPPING_COSMOS_CONTAINER=toppings

TOPPING_CORS_ALLOW_ORIGINS=*
